TikTok = select,韩国时延优选,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TikTok.png
社交媒体 = select,近邻时延优选,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/X.png
国际流媒体 = select,美国时延优选,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Netflix.png
