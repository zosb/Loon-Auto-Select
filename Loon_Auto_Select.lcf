# Regional auto selection: keep upstream 60s / tolerance 50 behavior.
香港时延优选 = url-test,香港节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
澳门时延优选 = url-test,澳门节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Macao.png
台湾时延优选 = url-test,台湾节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
日本时延优选 = url-test,日本节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
韩国时延优选 = url-test,韩国节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Korea.png
新加坡时延优选 = url-test,新国节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
美国时延优选 = url-test,美国节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png
英国时延优选 = url-test,英国节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_Kingdom.png
德国时延优选 = url-test,德国节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Germany.png

# Shared upper-layer tests reduce duplicate probing.
近邻时延优选 = url-test,香港时延优选,澳门时延优选,台湾时延优选,日本时延优选,新加坡时延优选,interval = 180,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
全球时延优选 = url-test,香港时延优选,澳门时延优选,台湾时延优选,日本时延优选,韩国时延优选,新加坡时延优选,美国时延优选,英国时延优选,德国时延优选,interval = 180,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png

YouTube专用优选 = url-test,YouTube专用节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
游戏时延优选 = url-test,游戏节点,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png

# AI is the only sticky category: fixed Singapore country + fallback for stable IP.
AI新加坡稳定 = fallback,新国节点,interval = 60,max-timeout = 2000,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png

Telegram = fallback,香港时延优选,澳门时延优选,台湾时延优选,日本时延优选,新加坡时延优选,美国时延优选,interval = 60,max-timeout = 2000,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Telegram.png
YouTube = fallback,YouTube专用优选,澳门时延优选,香港时延优选,台湾时延优选,日本时延优选,新加坡时延优选,美国时延优选,interval = 60,max-timeout = 2000,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png

ChatGPT = select,AI新加坡稳定,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChatGPT.png
Gemini = select,AI新加坡稳定,img-url = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/GoogleGemini.png
