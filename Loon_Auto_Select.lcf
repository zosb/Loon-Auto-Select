https://rule.kelee.one/Loon/Vercel.lsr, policy=开发服务, tag=Vercel, enabled=true

# 游戏：SteamCN 直连必须位于 Steam 大规则之前。
https://rule.kelee.one/Loon/SteamCN.lsr, policy=DIRECT, tag=Steam-CN, enabled=true
https://rule.kelee.one/Loon/Steam.lsr, policy=游戏平台, tag=Steam, enabled=true
https://rule.kelee.one/Loon/Epic.lsr, policy=游戏平台, tag=Epic, enabled=true
https://rule.kelee.one/Loon/PlayStation.lsr, policy=游戏平台, tag=PlayStation, enabled=true
https://rule.kelee.one/Loon/Xbox.lsr, policy=游戏平台, tag=Xbox, enabled=true

# Google 必须位于 Gemini / AI / YouTube 之后。
https://rule.kelee.one/Loon/Google.lsr, policy=Google, tag=Google, enabled=true

# Speedtest
https://kelee.one/Tool/Loon/Lsr/SpeedtestInternational.lsr, policy=全球时延优选, tag=Speedtest-Intl, enabled=true

# 中国大陆 REGION 保持远程规则最后。
https://kelee.one/Tool/Loon/Lsr/REGION_SPLITTER.lsr, policy=DIRECT, tag=CN-REGION, enabled=true

[Host]

[Rewrite]

[Script]

[Plugin]

# ============================================================
# 基础网络 / 广告层
# BlockAdvertisers 是专项去广告插件的基础，保持在插件列表顶部。
# ============================================================

https://kelee.one/Tool/Loon/Lpx/BlockAdvertisers.lpx, pin=true, enabled=true
https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx, pin=true, enabled=true

# 特定节点域名 DNS；仅匹配 *.node.daacc.org，不接管全局 DNS。
https://raw.githubusercontent.com/crushcloud91/Crush-Cloud/main/crushcloud-dns.plugin, img-url=externaldrive.badge.icloud, enabled=true

# ============================================================
# 国外常用 App 专项去广告
#
# 默认仅预装少量常用国外 App，避免把整个插件库全部塞进公共配置。
# 如需 X、Instagram、Facebook、TikTok 或其它国内 / 国外 App 去广告，
# 请前往可莉插件中心按需自行添加：https://hub.kelee.one
# 建议只启用实际需要的插件，以减少 Rewrite / Script / MitM 覆盖范围和维护成本。
# ============================================================

https://kelee.one/Tool/Loon/Lpx/YouTube_remove_ads.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/Spotify_remove_ads.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/Reddit_remove_ads.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/Pinterest_remove_ads.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/Line_remove_ads.lpx, enabled=true

# Spotify 插件仅用于广告处理，不等同于 Premium 解锁。
# 专项插件可能依赖 MitM，并可能随 App 更新需要同步更新。

# ============================================================
# 工具插件
# ============================================================

https://kelee.one/Tool/Loon/Lpx/QuickSearch.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/Prevent_DNS_Leaks.lpx, policy=兜底后备策略, enabled=true
https://kelee.one/Tool/Loon/Lpx/Node_detection_tool.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/BoxJs.lpx, policy=兜底后备策略, enabled=true
https://kelee.one/Tool/Loon/Lpx/Sub-Store.lpx, policy=兜底后备策略, enabled=true
https://kelee.one/Tool/Loon/Lpx/Script-Hub.lpx, policy=兜底后备策略, enabled=true

[Mitm]

# 公开仓库不保存证书材料。
# YouTube / Spotify / Reddit / Pinterest / LINE 等专项插件若依赖 HTTPS Rewrite，
# 请在 Loon 本地生成、安装并信任自己的 CA。
hostname =
ca-p12 =
ca-passphrase =
skip-server-cert-verify = false
