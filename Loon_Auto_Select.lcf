兜底后备策略 = fallback,香港时延优选,澳门时延优选,台湾时延优选,日本时延优选,新加坡时延优选,韩国时延优选,美国时延优选,英国时延优选,德国时延优选,interval = 60,max-timeout = 2000,img-url = https://github.com/shindgewongxj/WHATSINStash/raw/main/icon/fallback.png

[Rule]

# Grok / xAI core domains. Do not route the whole x.com domain to AI.
DOMAIN-SUFFIX,grok.com,Grok
DOMAIN-SUFFIX,grokusercontent.com,Grok
DOMAIN-SUFFIX,x.ai,Grok

FINAL,兜底后备策略

[Remote Rule]

# LAN first.
https://kelee.one/Tool/Loon/Lsr/LAN_SPLITTER.lsr, policy=DIRECT, tag=LAN, enabled=true

# Dedicated AI rules first; broad AI catch-all stays behind them.
https://rule.kelee.one/Loon/OpenAI.lsr, policy=ChatGPT, tag=ChatGPT, enabled=true
https://rule.kelee.one/Loon/Gemini.lsr, policy=Gemini, tag=Gemini, enabled=true
https://rule.kelee.one/Loon/Claude.lsr, policy=Claude, tag=Claude, enabled=true
https://rule.kelee.one/Loon/Copilot.lsr, policy=Copilot, tag=Copilot, enabled=true
https://kelee.one/Tool/Loon/Lsr/AI.lsr, policy=AI新加坡稳定, tag=AI-Other, enabled=true

# YouTube must stay before broad Google matching.
https://rule.kelee.one/Loon/YouTube.lsr, policy=YouTube, tag=YouTube, enabled=true
https://rule.kelee.one/Loon/YouTubeMusic.lsr, policy=YouTube, tag=YouTube-Music, enabled=true

https://rule.kelee.one/Loon/Telegram.lsr, policy=Telegram, tag=Telegram, enabled=true
https://kelee.one/Tool/Loon/Lsr/TikTok.lsr, policy=TikTok, tag=TikTok, enabled=true

# Social.
https://rule.kelee.one/Loon/Twitter.lsr, policy=社交媒体, tag=X-Twitter, enabled=true
https://rule.kelee.one/Loon/Threads.lsr, policy=社交媒体, tag=Threads, enabled=true
https://rule.kelee.one/Loon/Instagram.lsr, policy=社交媒体, tag=Instagram, enabled=true
https://rule.kelee.one/Loon/Facebook.lsr, policy=社交媒体, tag=Facebook, enabled=true
